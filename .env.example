# Estos dos valores son públicos y se encuentran en Supabase > Settings > API.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Sólo para probar la interfaz sin conectar Supabase. No usar en producción.
VITE_ENABLE_DEMO=false

# Nunca agregues aquí SERVICE_ROLE, SMTP_PASS, GROQ_API_KEY, WEATHERAPI_KEY,
# AIRSENSE_DEVICE_KEY ni claves de firma. Son secretos exclusivos de Supabase
# Edge Functions y deben cargarse con `supabase secrets set`.
#
# Configuración recomendada del servidor (sólo nombres, sin valores reales):
# ALLOWED_ORIGINS=https://tu-dominio.example,http://localhost,https://localhost
# TURNSTILE_SECRET_KEY=...  # opcional; al configurarlo el backend lo exige
